<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <Name>OpenGL GLUT Project</Name>
    <Description>C++ project with freeglut pre-configured. Requires freeglut.dll in System32. BSUIR26_badcatrad</Description>
    <ProjectType>VC</ProjectType>
    <ProjectSubType>
    </ProjectSubType>
    <SortOrder>1000</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>OpenGL GLUT Project</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <Icon>__TemplateIcon.png</Icon>
    <PreviewImage>__PreviewImage.png</PreviewImage>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$projectname$.vcxproj" File="MyGLUTP.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false" TargetFileName="$projectname$.vcxproj.filters">MyGLUTP.vcxproj.filters</ProjectItem>
      <ProjectItem ReplaceParameters="false" TargetFileName="main.cpp">main.cpp</ProjectItem>
      <Folder Name="DEPENDENCIES" TargetFolderName="dependencies">
        <Folder Name="INCLUDE" TargetFolderName="include">
          <Folder Name="GL" TargetFolderName="GL">
            <ProjectItem ReplaceParameters="false" TargetFileName="glut.h">glut.h</ProjectItem>
            <ProjectItem ReplaceParameters="false" TargetFileName="freeglut.h">freeglut.h</ProjectItem>
            <ProjectItem ReplaceParameters="false" TargetFileName="freeglut_ext.h">freeglut_ext.h</ProjectItem>
            <ProjectItem ReplaceParameters="false" TargetFileName="freeglut_std.h">freeglut_std.h</ProjectItem>
          </Folder>
        </Folder>
        <Folder Name="LIB" TargetFolderName="lib">
          <Folder Name="x64" TargetFolderName="x64">
            <ProjectItem ReplaceParameters="false" TargetFileName="freeglut.lib">freeglut.lib</ProjectItem>
          </Folder>
          <Folder Name="x86" TargetFolderName="x86">
            <ProjectItem ReplaceParameters="false" TargetFileName="freeglut.lib">freeglut.lib</ProjectItem>
          </Folder>
        </Folder>
      </Folder>
    </Project>
  </TemplateContent>
</VSTemplate>
